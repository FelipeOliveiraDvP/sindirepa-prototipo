# Copie para .env.local e preencha. .env.local está no .gitignore.
# Painel do Supabase → Project Settings → API

# URL do projeto. Ex.: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# ⚠️ SERVICE ROLE — ignora RLS e dá acesso total ao banco.
# NUNCA prefixar com NEXT_PUBLIC_: tudo que leva esse prefixo vai para o
# bundle do navegador. Esta chave só existe do lado do servidor, em
# Server Action.
SUPABASE_SERVICE_ROLE_KEY=

# Chave pública (anon / publishable). PODE ir para o navegador: ela
# respeita RLS, e é assim que o Supabase Auth funciona no cliente.
#
# A aplicação ainda não a usa. Quem usa é `npm run check:supabase`, para
# PROVAR que o RLS bloqueia a chave que roda no navegador de qualquer
# visitante. Sem ela esse teste é pulado — preencha.
SUPABASE_ANON_KEY=

# ⬜ FASE 4 (login). Mesmo valor da anterior, com o prefixo que o Next
# usa para expor ao cliente.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Benchmark: modo demonstração ────────────────────────────
# Mostra faixa ILUSTRATIVA no painel, com tarja permanente, para
# demonstrar a tela antes de existir amostra real.
#
# NUNCA ligar em produção. check-tokens quebra o build se esta linha
# for versionada com valor 1. Ver docs/saas/09-benchmark.md.
# NEXT_PUBLIC_BENCHMARK_DEMO=1
