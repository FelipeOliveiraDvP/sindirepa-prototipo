# Normaliza fim de linha no repositório: LF sempre.
# Sem isto, o Git avisa em cada commit feito no Windows e um colaborador
# em outro sistema veria o arquivo inteiro como alterado.
* text=auto eol=lf

# Binários — nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Gerado: colapsa no diff do GitHub em vez de poluir a revisão.
package-lock.json linguist-generated=true
