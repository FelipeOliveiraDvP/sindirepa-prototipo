{
  "name": "nocobi-precificacao",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de inteligencia de precificacao de mao de obra para oficinas automotivas independentes. Nocobi + UPLAB SENAI-SP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:tokens": "node scripts/check-tokens.mjs",
    "pretest": "npm run check:tokens",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check:tokens && npm run lint && vitest run && next build",
    "check:supabase": "node --env-file=.env.local scripts/check-supabase.mjs",
    "check:e2e": "node --env-file=.env.local scripts/e2e-calculadora.mjs",
    "check:conta": "node --env-file=.env.local scripts/check-conta.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}
